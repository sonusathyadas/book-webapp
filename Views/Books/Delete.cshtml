@model BookManager.Models.Book

<div class="card detail-card border-danger mx-auto" style="max-width: 640px;">
    <div class="card-body p-4">
        <h1 class="h3 text-danger fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Delete Book</h1>
        <p class="text-muted">Are you sure you want to delete this book? This cannot be undone.</p>
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>
            <dt class="col-sm-4">Author</dt>
            <dd class="col-sm-8">@Model.Author</dd>
            <dt class="col-sm-4">Genre</dt>
            <dd class="col-sm-8">@Model.Genre</dd>
            <dt class="col-sm-4">Language</dt>
            <dd class="col-sm-8">@Model.Language</dd>
            <dt class="col-sm-4">Pages</dt>
            <dd class="col-sm-8">@Model.NumberOfPages</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>