@model IEnumerable<BookManager.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="page-header">
    <h1 class="h2 fw-bold mb-0"><i class="bi bi-book me-2"></i>Books</h1>
    <a asp-action="Create" class="btn btn-brand"><i class="bi bi-plus-lg me-1"></i>Add New Book</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-journal-x display-3"></i>
        <p class="mt-3 mb-0">No books yet. Add your first one!</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var book in Model)
        {
            <div class="col">
                <div class="card book-card h-100">
                    @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                    {
                        <img src="@book.CoverImageUrl" class="book-cover" alt="Cover of @book.Title" />
                    }
                    else
                    {
                        <div class="book-cover-placeholder"><i class="bi bi-book"></i></div>
                    }
                    <div class="card-body">
                        <h5 class="card-title mb-1">@book.Title</h5>
                        <p class="text-muted mb-2">by @book.Author</p>
                        <span class="badge text-bg-primary">@book.Genre</span>
                        <span class="badge text-bg-secondary">@book.Language</span>
                        <p class="small text-muted mt-2 mb-0"><i class="bi bi-file-earmark-text me-1"></i>@book.NumberOfPages pages</p>
                    </div>
                    <div class="card-footer bg-white border-0 d-flex gap-2 pb-3">
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info flex-fill">Details</a>
                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-warning flex-fill">Edit</a>
                        <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-outline-danger flex-fill">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}